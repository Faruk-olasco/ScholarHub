{
  "name": "scholarhub-mobile",
  "version": "1.2.0",
  "private": true,
  "scripts": {
    "add:android": "npx cap add android",
    "sync": "npx cap sync android",
    "open": "npx cap open android",
    "apk:debug": "npx cap sync android && cd android && ./gradlew assembleDebug",
    "apk:release": "npx cap sync android && cd android && ./gradlew assembleRelease",
    "aab:release": "npx cap sync android && cd android && ./gradlew bundleRelease"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor-firebase/messaging": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/local-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "firebase": "^12.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0"
  }
}
