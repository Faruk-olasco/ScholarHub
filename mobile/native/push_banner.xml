<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:background="#FFFFFF">
    <ImageView android:id="@+id/push_img" android:layout_width="match_parent" android:layout_height="170dp"
        android:scaleType="centerCrop" android:contentDescription="@null"/>
    <LinearLayout android:id="@+id/push_logo_wrap" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:paddingTop="12dp" android:background="#F1F5F9">
        <ImageView android:id="@+id/push_logo" android:layout_width="match_parent" android:layout_height="84dp"
            android:scaleType="fitCenter" android:contentDescription="@null"/>
    </LinearLayout>
    <TextView android:id="@+id/push_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="10dp"
        android:textColor="#0F172A" android:textSize="15sp" android:textStyle="bold" android:maxLines="2" android:ellipsize="end"/>
    <TextView android:id="@+id/push_body" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="3dp"
        android:textColor="#334155" android:textSize="13sp" android:maxLines="3" android:ellipsize="end"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:gravity="center_vertical" android:paddingLeft="16dp" android:paddingRight="16dp" android:paddingTop="8dp" android:paddingBottom="12dp">
        <TextView android:id="@+id/push_chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/push_chip" android:paddingLeft="10dp" android:paddingRight="10dp" android:paddingTop="3dp" android:paddingBottom="3dp"
            android:textColor="#B91C1C" android:textSize="11sp" android:textStyle="bold"/>
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="right"
            android:text="Tap to open ›" android:textColor="#64748B" android:textSize="12sp"/>
    </LinearLayout>
</LinearLayout>
