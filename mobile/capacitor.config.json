{
  "appId": "com.scholarhub.app",
  "appName": "ScholarHub",
  "webDir": "www",
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 1200,
      "backgroundColor": "#f8fafc",
      "androidScaleType": "CENTER_CROP"
    },
    "StatusBar": {
      "style": "LIGHT",
      "backgroundColor": "#f8fafc"
    },
    "Browser": {}
  },
  "server": {
    "androidScheme": "https"
  }
}
